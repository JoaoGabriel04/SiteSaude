generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusUrgencia {
  URGENTE
  MODERADO
  BAIXO
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
}

enum StatusAtendimento {
  AGENDADO
  CANCELADO
  FINALIZADO
}

enum TipoAtendimento {
  CONSULTA
  EXAME
  PROCEDIMENTO
  RETORNO
}

enum Role {
  MEDICO
  ATENDENTE
  ADMIN
}

enum StatusProfissional {
  ATIVO
  INATIVO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADO
  NEGADO
}

model Agenda {
  id            String   @id @default(uuid())
  horario_atend DateTime
  duracaoMin    Int      @default(30)

  statusUrgencia StatusUrgencia    @default(BAIXO)
  status         StatusAtendimento @default(AGENDADO)

  tipo        TipoAtendimento @default(CONSULTA)
  motivo      String?
  observacoes String?

  patientId   String
  docId       String
  createdById String

  paciente   Patient @relation(fields: [patientId], references: [id])
  medico     Doctor  @relation(fields: [docId], references: [userId])
  createdBy  User    @relation("CreatedBy", fields: [createdById], references: [id])
  canceledBy User?   @relation("CanceledBy", fields: [canceledById], references: [id])

  cancelReason String?
  canceledById String?
  canceledAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attend       Attend?  @relation(fields: [attendUserId], references: [userId])
  attendUserId String?

  @@map("agendas")
}

model Disponibilidade {
  id           String  @id @default(uuid())
  docId        String
  diaSemana    Int
  horaInicio   String
  horaFim      String
  almocoInicio String?
  almocoFim    String?

  medico Doctor @relation(fields: [docId], references: [userId])

  @@unique([docId, diaSemana])
  @@map("disponibilidades")
}

model ExcecaoMedico {
  id     String   @id @default(uuid())
  docId  String
  data   DateTime
  motivo String?

  status          StatusSolicitacao @default(PENDENTE)
  observacaoAdmin String?
  aprovadoPorId   String?
  dataSolicitacao DateTime          @default(now())
  dataResposta    DateTime?

  medico      Doctor @relation(fields: [docId], references: [userId])
  aprovadoPor User?  @relation("AprovadoPor", fields: [aprovadoPorId], references: [id])

  @@unique([docId, data])
  @@map("excecoes_medico")
}

model SolicitacaoAusencia {
  id     String  @id @default(uuid())
  docId  String
  motivo String?

  status          StatusSolicitacao @default(PENDENTE)
  observacaoAdmin String?
  aprovadoPorId   String?
  dataSolicitacao DateTime          @default(now())
  dataResposta    DateTime?

  medico      Doctor @relation(fields: [docId], references: [userId])
  aprovadoPor User?  @relation("AprovadoPorSolicitacao", fields: [aprovadoPorId], references: [id])

  dias SolicitacaoAusenciaDia[]

  @@map("solicitacoes_ausencia")
}

model SolicitacaoAusenciaDia {
  id            String   @id @default(uuid())
  solicitacaoId String
  data          DateTime

  solicitacao SolicitacaoAusencia @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@unique([solicitacaoId, data])
  @@map("solicitacoes_ausencia_dias")
}

model Notificacao {
  id        String   @id @default(uuid())
  userId    String
  titulo    String
  mensagem  String
  tipo      String // "SOLICITACAO_APROVADA", "SOLICITACAO_NEGADA", etc.
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notificacoes")
}

model User {
  id         String   @id @default(uuid())
  nome       String   @db.VarChar(100)
  cpf        String   @unique @db.VarChar(11)
  nascimento DateTime
  fone       String   @db.VarChar(11)
  email      String   @unique
  password   String   @db.VarChar(255)
  avatar     String?

  role Role

  medico    Doctor?
  atendente Attend?

  createdAgendas        Agenda[]              @relation("CreatedBy")
  canceledAgendas       Agenda[]              @relation("CanceledBy")
  notificacoes          Notificacao[]
  excecoesAprovadas     ExcecaoMedico[]       @relation("AprovadoPor")
  solicitacoesAprovadas SolicitacaoAusencia[] @relation("AprovadoPorSolicitacao")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Doctor {
  userId        String @id
  crm           String @unique
  especialidade String

  user User @relation(fields: [userId], references: [id])

  disponibilidades Disponibilidade[]
  excecoes         ExcecaoMedico[]
  solicitacoes     SolicitacaoAusencia[]

  agendas Agenda[]

  status StatusProfissional @default(ATIVO)

  @@map("doctors")
}

model Patient {
  id         String   @id @default(uuid())
  nome       String
  cpf        String   @unique
  nascimento DateTime
  fone       String
  email      String?
  cartaoSus  String   @unique
  sexo       Sexo     @default(OUTRO)

  agendas Agenda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patients")
}

model Attend {
  userId String @id
  setor  String

  user User @relation(fields: [userId], references: [id])

  agendas Agenda[]

  @@map("attends")
}
